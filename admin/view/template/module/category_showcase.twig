{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-showcase" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <form id="form-showcase" action="{{ save }}" method="post" data-oc-toggle="ajax">
      <div class="card">
        <div class="card-header"><i class="fa-solid fa-gear"></i> {{ heading_title }}</div>
        <div class="card-body">
          <div class="row mb-3 align-items-center">
            <label class="col-sm-3 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-9">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_category_showcase_status" value="0" />
                <input class="form-check-input" type="checkbox" role="switch" id="sw-cs-status" name="module_category_showcase_status" value="1"{% if module_category_showcase_status %} checked{% endif %} />
                <label class="form-check-label" for="sw-cs-status" id="lbl-cs-status">
                  {% if module_category_showcase_status %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}
                </label>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_limit }}</label>
            <div class="col-sm-9">
              <input type="number" name="module_category_showcase_limit" min="1" max="12" value="{{ module_category_showcase_limit }}" class="form-control" style="max-width: 150px;" />
              <div class="form-text">{{ help_limit }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_manual_ids }}</label>
            <div class="col-sm-9">
              <input type="text" name="module_category_showcase_manual_ids" value="{{ module_category_showcase_manual_ids }}" class="form-control" placeholder="220,12576,1249" />
              <div class="form-text">{{ help_manual_ids }}</div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
document.getElementById('sw-cs-status').addEventListener('change', function () {
  document.getElementById('lbl-cs-status').textContent = this.checked ? {{ text_enabled|json_encode|raw }} : {{ text_disabled|json_encode|raw }};
});
</script>

{{ footer }}
