{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ recalculate }}" data-oc-toggle="ajax" data-bs-toggle="tooltip" title="{{ button_recalculate }}" class="btn btn-warning"><i class="fa-solid fa-arrows-rotate"></i></a>
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }} <small class="text-muted">v{{ module_version }}</small></h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}

    <ul class="nav nav-tabs" id="cm-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-main" type="button" role="tab">
          <i class="fa-solid fa-chart-column"></i> {{ tab_dashboard }}
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-overrides" type="button" role="tab">
          <i class="fa-solid fa-sliders"></i> {{ tab_overrides }}
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="cm-tab-updates-link" data-bs-toggle="tab" data-bs-target="#tab-updates" type="button" role="tab">
          <i class="fa-brands fa-github"></i> {{ tab_updates }}
        </button>
      </li>
    </ul>

    <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
      <input type="hidden" id="overrides_json" name="overrides_json" value="{{ module_category_merch_overrides|json_encode|escape('html_attr') }}" />

      <div class="tab-content border border-top-0 p-4 bg-white">

        {# ============ TAB: MAIN (Dashboard + Settings, order depends on status) ============ #}
        <div class="tab-pane fade show active" id="tab-main" role="tabpanel">

          {% set settings_block %}
            <div class="card">
              <div class="card-header"><i class="fa-solid fa-gear"></i> {{ tab_settings }}</div>
              <div class="card-body">
                <div class="row mb-3 align-items-center">
                  <label class="col-sm-3 col-form-label">{{ entry_status }}</label>
                  <div class="col-sm-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="module_category_merch_status" value="0" />
                      <input class="form-check-input" type="checkbox" role="switch" id="sw-status" name="module_category_merch_status" value="1"{% if module_category_merch_status %} checked{% endif %} />
                      <label class="form-check-label" for="sw-status" id="lbl-status">
                        {% if module_category_merch_status %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}
                      </label>
                    </div>
                  </div>
                </div>

                <div class="row mb-3 align-items-center">
                  <label class="col-sm-3 col-form-label">{{ entry_hide_empty }}</label>
                  <div class="col-sm-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="module_category_merch_hide_empty" value="0" />
                      <input class="form-check-input" type="checkbox" role="switch" id="sw-hide-empty" name="module_category_merch_hide_empty" value="1"{% if module_category_merch_hide_empty %} checked{% endif %} />
                      <label class="form-check-label" for="sw-hide-empty" id="lbl-hide-empty">
                        {% if module_category_merch_hide_empty %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}
                      </label>
                    </div>
                    <div class="form-text">{{ help_hide_empty }}</div>
                  </div>
                </div>

                <div class="row mb-3 align-items-center">
                  <label class="col-sm-3 col-form-label">{{ entry_hide_empty_subs }}</label>
                  <div class="col-sm-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="module_category_merch_hide_empty_subs" value="0" />
                      <input class="form-check-input" type="checkbox" role="switch" id="sw-hide-empty-subs" name="module_category_merch_hide_empty_subs" value="1"{% if module_category_merch_hide_empty_subs %} checked{% endif %} />
                      <label class="form-check-label" for="sw-hide-empty-subs" id="lbl-hide-empty-subs">
                        {% if module_category_merch_hide_empty_subs %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}
                      </label>
                    </div>
                    <div class="form-text">{{ help_hide_empty_subs }}</div>
                  </div>
                </div>

                <div class="row mb-3 align-items-center">
                  <label class="col-sm-3 col-form-label">{{ entry_sort_by_score }}</label>
                  <div class="col-sm-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="module_category_merch_sort_by_score" value="0" />
                      <input class="form-check-input" type="checkbox" role="switch" id="sw-sort" name="module_category_merch_sort_by_score" value="1"{% if module_category_merch_sort_by_score %} checked{% endif %} />
                      <label class="form-check-label" for="sw-sort" id="lbl-sort">
                        {% if module_category_merch_sort_by_score %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}
                      </label>
                    </div>
                    <div class="form-text">{{ help_sort_by_score }}</div>
                  </div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_weight_volume }}</label>
                  <div class="col-sm-9">
                    <input type="number" name="module_category_merch_weight_volume" min="0" max="100" value="{{ module_category_merch_weight_volume }}" class="form-control" />
                  </div>
                </div>

                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_cache_ttl }}</label>
                  <div class="col-sm-9">
                    <input type="number" name="module_category_merch_cache_ttl" min="30" max="86400" value="{{ module_category_merch_cache_ttl }}" class="form-control" />
                    <div class="form-text">{{ help_cache_ttl }}</div>
                  </div>
                </div>
              </div>
            </div>
          {% endset %}

          {# ---- Empty-category cleanup: the concrete, one-click use of Overrides ---- #}
          <div class="card {% if empty_category_count > 0 %}border-warning{% endif %}">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
              <div>
                <div class="fw-semibold">
                  {% if empty_category_count > 0 %}
                    <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                    {{ text_empty_cleanup_title }}: <span class="badge bg-warning text-dark">{{ empty_category_count }}</span>
                  {% else %}
                    <i class="fa-solid fa-circle-check text-success"></i> {{ text_empty_cleanup_none }}
                  {% endif %}
                </div>
              </div>
              {% if empty_category_count > 0 %}
                <button type="button" class="btn btn-warning" id="cm-bulk-hide-empty"><i class="fa-solid fa-eye-slash"></i> {{ button_hide_all_empty }}</button>
              {% endif %}
            </div>
          </div>

          {# ---- Primary view: leaf categories — where your stock actually lives ---- #}
          <div class="card mt-3">
            <div class="card-header"><i class="fa-solid fa-boxes-stacked"></i> {{ text_leaf_categories }}</div>
            <div class="card-body">
              <p class="text-muted small mb-3">{{ text_leaf_categories_hint }}</p>
              {% if leaf_rows|length > 0 %}
                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                  <table class="table table-sm table-striped mb-0">
                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                      <tr>
                        <th>{{ column_name }}</th>
                        <th class="text-end" style="width: 140px;">{{ column_total }}</th>
                        <th class="text-end" style="width: 200px;">{{ column_score }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for row in leaf_rows %}
                        <tr>
                          <td>{{ row.name }}</td>
                          <td class="text-end">{{ row.total }}</td>
                          <td class="text-end">
                            <div class="d-flex align-items-center gap-2">
                              <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: {{ row.score }}%;"></div>
                              </div>
                              <span class="text-nowrap" style="min-width: 40px;">{{ row.score }}%</span>
                            </div>
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% else %}
                <div class="text-center text-muted py-5">
                  <i class="fa-solid fa-boxes-stacked fa-3x mb-3"></i>
                  <p>{{ text_no_results }}</p>
                </div>
              {% endif %}
            </div>
          </div>

          {# ---- Secondary: generic parent-category rollup, collapsed by default ---- #}
          <details class="card mt-3">
            <summary class="card-header" style="cursor: pointer;"><i class="fa-solid fa-chart-column"></i> {{ text_general_view }}</summary>
            <div class="card-body">
              {% if chart_labels|length > 0 %}
                <div class="row">
                  <div class="col-lg-7">
                    <div style="position: relative; height: 420px;">
                      <canvas id="cm-chart"></canvas>
                    </div>
                  </div>
                  <div class="col-lg-5">
                    <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                      <table class="table table-sm table-striped">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                          <tr>
                            <th>{{ column_name }}</th>
                            <th class="text-end">{{ column_total }}</th>
                            <th class="text-end">{{ column_score }}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {% for row in dashboard_rows %}
                            {% if row.total > 0 %}
                            <tr>
                              <td>{{ row.name }}</td>
                              <td class="text-end">{{ row.total }}</td>
                              <td class="text-end">
                                <div class="d-flex align-items-center gap-2">
                                  <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-success" style="width: {{ row.score }}%;"></div>
                                  </div>
                                  <span class="text-nowrap" style="min-width: 40px;">{{ row.score }}%</span>
                                </div>
                              </td>
                            </tr>
                            {% endif %}
                          {% endfor %}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="text-center text-muted py-5">
                  <i class="fa-solid fa-chart-simple fa-3x mb-3"></i>
                  <p>{{ text_no_results }}</p>
                </div>
              {% endif %}
            </div>
          </details>

          {# ---- Full tree explorer, for deep manual digging ---- #}
          <details class="card mt-3">
            <summary class="card-header" style="cursor: pointer;"><i class="fa-solid fa-sitemap"></i> {{ text_category_tree }}</summary>
            <div class="card-body">
              <p class="text-muted small mb-3">{{ text_category_tree_hint }}</p>
              <div id="cm-tree-root" class="cm-tree"></div>
            </div>
          </details>

          <div class="mt-3">{{ settings_block }}</div>

        </div>

        {# ============ TAB: OVERRIDES (AJAX-paginated) ============ #}
        <div class="tab-pane fade" id="tab-overrides" role="tabpanel">
          <div class="row mb-3">
            <div class="col-md-6">
              <div class="input-group">
                <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="search" id="ovr-search" class="form-control" placeholder="{{ column_name }}..." />
              </div>
            </div>
            <div class="col-md-6 text-end">
              <span class="text-muted small" id="ovr-count">{{ dashboard_tree_total }} categories · page 1 / <span id="ovr-total-pages">1</span></span>
            </div>
          </div>

          <div class="table-responsive" style="max-height: 600px; overflow-y: auto; border: 1px solid #e6e6e6; border-radius: 4px;">
            <table class="table table-sm table-striped mb-0">
              <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                <tr>
                  <th>{{ column_name }}</th>
                  <th class="text-end" style="width: 140px;">{{ column_total }}</th>
                  <th class="text-end" style="width: 180px;">{{ column_score }} <i class="fa-solid fa-arrow-down-wide-short small"></i></th>
                  <th style="width: 220px;">{{ column_override }}</th>
                  <th style="width: 110px;">{{ column_status }}</th>
                </tr>
              </thead>
              <tbody id="ovr-tbody">
                {% if dashboard_tree %}
                  {% for row in dashboard_tree %}
                    {% set mode = module_category_merch_overrides[row.category_id] is defined ? module_category_merch_overrides[row.category_id] : 0 %}
                    <tr>
                      <td>
                        {% if row.level > 0 %}{% for i in 1..row.level %}&nbsp;&nbsp;&nbsp;{% endfor %}{% endif %}
                        {{ row.name }}
                      </td>
                      <td class="text-end">{{ row.total }}</td>
                      <td class="text-end">
                        <div class="d-flex align-items-center gap-2">
                          <div class="progress flex-grow-1" style="height: 6px;">
                            <div class="progress-bar bg-info" style="width: {{ row.score }}%;"></div>
                          </div>
                          <span class="text-nowrap" style="min-width: 40px;">{{ row.score }}%</span>
                        </div>
                      </td>
                      <td>
                        <select class="form-select form-select-sm ovr-select" data-cid="{{ row.category_id }}">
                          <option value="0"{% if mode == 0 %} selected{% endif %}>{{ text_auto }}</option>
                          <option value="1"{% if mode == 1 %} selected{% endif %}>{{ text_force_show }}</option>
                          <option value="-1"{% if mode == -1 %} selected{% endif %}>{{ text_force_hide }}</option>
                        </select>
                      </td>
                      <td>
                        {% if row.status %}
                          <span class="badge bg-success">{{ text_enabled }}</span>
                        {% else %}
                          <span class="badge bg-secondary">{{ text_disabled }}</span>
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr><td colspan="5" class="text-center">{{ text_no_results }}</td></tr>
                {% endif %}
              </tbody>
            </table>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="ovr-prev"><i class="fa-solid fa-angle-left"></i></button>
            <div id="ovr-loading" class="text-muted small" style="display: none;"><i class="fa-solid fa-spinner fa-spin"></i></div>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="ovr-next"><i class="fa-solid fa-angle-right"></i></button>
          </div>
        </div>

        {# ============ TAB: UPDATES ============ #}
        <div class="tab-pane fade" id="tab-updates" role="tabpanel">
          {% if not module_repository %}
            <em class="text-muted">{{ text_no_repository }}</em>
          {% else %}
            <div class="row mb-3">
              <label class="col-sm-3 col-form-label">{{ text_current_version }}</label>
              <div class="col-sm-9">
                <span class="badge bg-primary fs-6">v{{ module_version }}</span>
              </div>
            </div>
            <div id="cm-update-result" class="d-none">
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ text_latest_version }}</label>
                <div class="col-sm-9">
                  <span id="cm-latest-badge" class="badge fs-6"></span>
                </div>
              </div>
              <div id="cm-update-available" class="d-none">
                <div class="alert alert-success">
                  <i class="fa-solid fa-circle-up"></i> {{ text_update_available }}
                  <button type="button" class="btn btn-sm btn-success ms-2" id="cm-install-update"><i class="fa-solid fa-download"></i> {{ button_install_update }}</button>
                  <a id="cm-release-link" href="#" class="btn btn-sm btn-outline-secondary ms-1" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> {{ button_view_release }}</a>
                </div>
                <div id="cm-install-progress" class="d-none">
                  <div class="d-flex align-items-center gap-2 text-muted mb-2"><i class="fa-solid fa-spinner fa-spin"></i> {{ text_installing }}</div>
                </div>
                <div id="cm-install-success" class="d-none">
                  <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <span id="cm-install-success-msg"></span></div>
                </div>
                <div id="cm-install-error" class="d-none">
                  <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <span id="cm-install-error-msg"></span></div>
                </div>
              </div>
              <div id="cm-update-current" class="d-none">
                <div class="alert alert-info"><i class="fa-solid fa-circle-check"></i> {{ text_up_to_date }}</div>
              </div>
              <div id="cm-changelog-section" class="d-none">
                <h6><i class="fa-solid fa-scroll"></i> {{ text_changelog }}</h6>
                <div id="cm-changelog-body" class="border rounded p-3 bg-light" style="white-space:pre-wrap;font-size:.85rem;max-height:300px;overflow-y:auto"></div>
              </div>
            </div>
            <div id="cm-update-loading" class="d-none">
              <div class="d-flex align-items-center gap-2 text-muted"><i class="fa-solid fa-spinner fa-spin"></i> {{ text_checking }}</div>
            </div>
            <div id="cm-update-error" class="d-none">
              <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <span id="cm-update-error-msg"></span></div>
            </div>
            <hr>
            <h6><i class="fa-solid fa-clock-rotate-left"></i> {{ text_version_history }}</h6>
            <div id="cm-version-history">
              <div class="text-muted small">{{ text_version_history_hint }}</div>
            </div>
            <div class="mt-3">
              <button type="button" class="btn btn-outline-secondary btn-sm" id="cm-check-update"><i class="fa-solid fa-arrows-rotate"></i> {{ button_refresh }}</button>
            </div>
            <div class="form-text mt-2">{{ text_update_source }} <a href="https://github.com/{{ module_repository }}" target="_blank" rel="noopener" class="text-decoration-none"><i class="fa-brands fa-github"></i> {{ module_repository }}</a></div>
          {% endif %}
        </div>

      </div>
    </form>
  </div>
</div>

<script>
// ---- Switch label sync ----
document.querySelectorAll('#tab-main .form-check-input[type="checkbox"]').forEach(function (cb) {
  var label = document.getElementById('lbl-' + cb.id.replace(/^sw-/, ''));
  if (!label) return;
  cb.addEventListener('change', function () {
    label.textContent = cb.checked ? {{ text_enabled|json_encode|raw }} : {{ text_disabled|json_encode|raw }};
  });
});

// ---- Chart.js bar chart (lazy: it now lives inside a collapsed <details>,
// and Chart.js sizes itself wrong if drawn while the canvas is hidden) ----
(function () {
  var labels = {{ chart_labels|json_encode|raw }};
  var totals = {{ chart_totals|json_encode|raw }};
  var canvas = document.getElementById('cm-chart');
  if (!canvas || !labels.length) return;

  var drawn = false;

  function drawChart() {
    if (drawn) return;
    if (typeof Chart === 'undefined') {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
      s.onload = drawChart;
      document.head.appendChild(s);
      return;
    }
    drawn = true;
    new Chart(canvas.getContext('2d'), {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: {{ column_total|json_encode|raw }},
          data: totals,
          backgroundColor: 'rgba(40, 167, 69, 0.7)',
          borderColor: 'rgba(40, 167, 69, 1)',
          borderWidth: 1
        }]
      },
      options: {
        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });
  }

  var details = canvas.closest('details');
  if (details) {
    if (details.open) drawChart();
    details.addEventListener('toggle', function () { if (details.open) drawChart(); });
  } else {
    drawChart();
  }
})();

// ---- Overrides pagination + search + state tracking ----
(function () {
  var URL_OVR = {{ overrides_url|json_encode|raw }};
  var TEXT_AUTO = {{ text_auto|json_encode|raw }};
  var TEXT_FORCE_SHOW = {{ text_force_show|json_encode|raw }};
  var TEXT_FORCE_HIDE = {{ text_force_hide|json_encode|raw }};
  var TEXT_ENABLED = {{ text_enabled|json_encode|raw }};
  var TEXT_DISABLED = {{ text_disabled|json_encode|raw }};
  var TEXT_NO_RESULTS = {{ text_no_results|json_encode|raw }};

  var hidden = document.getElementById('overrides_json');
  var state = {};
  try { state = JSON.parse(hidden.value) || {}; } catch (e) { state = {}; }

  var tbody = document.getElementById('ovr-tbody');
  var searchInput = document.getElementById('ovr-search');
  var btnPrev = document.getElementById('ovr-prev');
  var btnNext = document.getElementById('ovr-next');
  var loading = document.getElementById('ovr-loading');
  var count = document.getElementById('ovr-count');
  var totalPages = document.getElementById('ovr-total-pages');

  var page = 1;
  var pages = 1;
  var searchTimer = null;

  // Escape HTML
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

  function persistState() {
    hidden.value = JSON.stringify(state);
  }

  function bindRowSelects() {
    tbody.querySelectorAll('.ovr-select').forEach(function (sel) {
      // Set from state if present
      var cid = sel.getAttribute('data-cid');
      if (state[cid] !== undefined) {
        sel.value = String(state[cid]);
      }
      sel.addEventListener('change', function () {
        var v = parseInt(sel.value, 10) || 0;
        if (v === 0) { delete state[cid]; }
        else { state[cid] = v; }
        persistState();
      });
    });
  }
  bindRowSelects();

  function renderRows(rows) {
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center">' + esc(TEXT_NO_RESULTS) + '</td></tr>';
      return;
    }
    var html = '';
    rows.forEach(function (r) {
      var indent = '';
      for (var i = 0; i < r.level; i++) { indent += '&nbsp;&nbsp;&nbsp;'; }
      var mode = state[r.category_id] !== undefined ? state[r.category_id] : r.mode;
      html += '<tr>' +
        '<td>' + indent + esc(r.name) + '</td>' +
        '<td class="text-end">' + r.total + '</td>' +
        '<td class="text-end">' +
          '<div class="d-flex align-items-center gap-2">' +
            '<div class="progress flex-grow-1" style="height: 6px;"><div class="progress-bar bg-info" style="width: ' + r.score + '%;"></div></div>' +
            '<span class="text-nowrap" style="min-width: 40px;">' + r.score + '%</span>' +
          '</div>' +
        '</td>' +
        '<td>' +
          '<select class="form-select form-select-sm ovr-select" data-cid="' + r.category_id + '">' +
            '<option value="0"' + (mode == 0 ? ' selected' : '') + '>' + esc(TEXT_AUTO) + '</option>' +
            '<option value="1"' + (mode == 1 ? ' selected' : '') + '>' + esc(TEXT_FORCE_SHOW) + '</option>' +
            '<option value="-1"' + (mode == -1 ? ' selected' : '') + '>' + esc(TEXT_FORCE_HIDE) + '</option>' +
          '</select>' +
        '</td>' +
        '<td>' + (r.status ? '<span class="badge bg-success">' + esc(TEXT_ENABLED) + '</span>' : '<span class="badge bg-secondary">' + esc(TEXT_DISABLED) + '</span>') + '</td>' +
      '</tr>';
    });
    tbody.innerHTML = html;
    bindRowSelects();
  }

  function fetchPage() {
    loading.style.display = '';
    var url = URL_OVR + '&page=' + page + '&search=' + encodeURIComponent(searchInput.value.trim());
    fetch(url, {
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
    })
      .then(function (r) { return r.json(); })
      .then(function (j) {
        loading.style.display = 'none';
        if (j.error) {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">' + esc(j.error) + '</td></tr>';
          return;
        }
        pages = Math.max(1, j.pages || 1);
        page = j.page || 1;
        count.firstChild.nodeValue = j.total + ' categories · page ' + page + ' / ';
        totalPages.textContent = pages;
        renderRows(j.rows || []);
      })
      .catch(function () {
        loading.style.display = 'none';
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Network error</td></tr>';
      });
  }

  btnPrev.addEventListener('click', function () { if (page > 1) { page--; fetchPage(); } });
  btnNext.addEventListener('click', function () { if (page < pages) { page++; fetchPage(); } });
  searchInput.addEventListener('input', function () {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function () { page = 1; fetchPage(); }, 350);
  });
})();

// ---- Update checker (same UX/logic as Debug Logger's Updates tab) ----
(function () {
  var checkBtn = document.getElementById('cm-check-update');
  var tabLink = document.getElementById('cm-tab-updates-link');
  if (!checkBtn || !tabLink) return;

  var TEXT_SESSION_EXPIRED = {{ text_session_expired|json_encode|raw }};
  var TEXT_VERSION_INSTALLED = {{ text_version_installed|json_encode|raw }};
  var TEXT_VERSION_NEWER = {{ text_version_newer|json_encode|raw }};
  var TEXT_VERSION_DOWNGRADE = {{ text_version_downgrade|json_encode|raw }};
  var TEXT_CONFIRM_DOWNGRADE = {{ text_confirm_downgrade|json_encode|raw }};
  var BUTTON_VIEW_RELEASE = {{ button_view_release|json_encode|raw }};
  var URL_CHECK = {{ check_updates|json_encode|raw }};
  var URL_INSTALL = {{ install_update|json_encode|raw }};

  var cmDownloadUrl = '';
  var cmChecked = false;

  // A stale/expired admin session makes OpenCart return the login page
  // (real HTML, HTTP 200) instead of JSON. Detect that case explicitly so
  // we never try to render raw HTML as JSON.
  function parseJsonOrThrow(t) {
    try {
      return JSON.parse(t);
    } catch (e) {
      if (/^\s*</.test(t)) {
        throw new Error(TEXT_SESSION_EXPIRED);
      }
      throw new Error('Invalid JSON: ' + t.substring(0, 200));
    }
  }

  function cmEscHtml(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function cmFormatDate(iso) { try { return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); } catch (e) { return iso; } }
  function cmVersionCompare(a, b) {
    var pa = String(a).split('.'), pb = String(b).split('.');
    for (var i = 0; i < 3; i++) {
      var na = parseInt(pa[i] || '0', 10), nb = parseInt(pb[i] || '0', 10);
      if (na > nb) return 1;
      if (na < nb) return -1;
    }
    return 0;
  }

  function cmRenderVersionHistory(versions, currentVersion) {
    var container = document.getElementById('cm-version-history');
    var html = '<div class="list-group list-group-flush">';
    versions.forEach(function (v) {
      var isCurrent = v.version === currentVersion;
      var isNewer = cmVersionCompare(v.version, currentVersion) > 0;
      var badgeClass = isCurrent ? 'bg-primary' : (isNewer ? 'bg-success' : 'bg-secondary');
      var badgeLabel = isCurrent ? TEXT_VERSION_INSTALLED : (isNewer ? TEXT_VERSION_NEWER : '');

      html += '<div class="list-group-item' + (isCurrent ? ' list-group-item-primary' : '') + '">';
      html += '<div class="d-flex justify-content-between align-items-center">';
      html += '<div><strong>v' + cmEscHtml(v.version) + '</strong> ';
      if (badgeLabel) html += '<span class="badge ' + badgeClass + ' ms-1" style="font-size:.7em">' + badgeLabel + '</span>';
      if (v.published_at) html += ' <small class="text-muted ms-2">' + cmFormatDate(v.published_at) + '</small>';
      html += '</div><div>';
      if (v.html_url) html += '<a href="' + cmEscHtml(v.html_url) + '" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm me-1" title="' + BUTTON_VIEW_RELEASE + '"><i class="fa-brands fa-github"></i></a>';
      if (v.download_url && !isCurrent && !isNewer) html += '<button type="button" class="btn btn-outline-warning btn-sm cm-install-version" data-url="' + cmEscHtml(v.download_url) + '" title="' + TEXT_VERSION_DOWNGRADE + '"><i class="fa-solid fa-download"></i></button>';
      html += '</div></div>';
      if (v.changelog) html += '<div class="mt-1 small text-muted" style="white-space:pre-wrap;max-height:80px;overflow-y:auto">' + cmEscHtml(v.changelog) + '</div>';
      html += '</div>';
    });
    html += '</div>';
    container.innerHTML = html;

    container.querySelectorAll('.cm-install-version').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm(TEXT_CONFIRM_DOWNGRADE)) return;
        cmDownloadUrl = this.getAttribute('data-url');
        document.getElementById('cm-install-update').click();
      });
    });
  }

  function cmCheckUpdate() {
    var loading = document.getElementById('cm-update-loading');
    var result = document.getElementById('cm-update-result');
    var errorDiv = document.getElementById('cm-update-error');
    result.classList.add('d-none');
    errorDiv.classList.add('d-none');
    document.getElementById('cm-install-success').classList.add('d-none');
    document.getElementById('cm-install-error').classList.add('d-none');
    loading.classList.remove('d-none');

    fetch(URL_CHECK, {
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
    })
      .then(function (r) { return r.text().then(parseJsonOrThrow); })
      .then(function (json) {
        loading.classList.add('d-none');
        cmChecked = true;
        if (json.error) {
          errorDiv.classList.remove('d-none');
          document.getElementById('cm-update-error-msg').textContent = json.error;
          return;
        }
        result.classList.remove('d-none');
        var badge = document.getElementById('cm-latest-badge');
        badge.textContent = 'v' + json.latest_version;
        badge.className = 'badge fs-6 ' + (json.has_update ? 'bg-success' : 'bg-info');
        if (json.has_update) {
          document.getElementById('cm-update-available').classList.remove('d-none');
          document.getElementById('cm-update-current').classList.add('d-none');
          cmDownloadUrl = json.download_url || '';
          if (json.html_url) document.getElementById('cm-release-link').href = json.html_url;
          if (tabLink && !tabLink.querySelector('.badge')) {
            tabLink.insertAdjacentHTML('beforeend', ' <span class="badge bg-success rounded-pill">' + TEXT_VERSION_NEWER + '</span>');
          }
        } else {
          document.getElementById('cm-update-available').classList.add('d-none');
          document.getElementById('cm-update-current').classList.remove('d-none');
        }
        if (json.changelog) {
          document.getElementById('cm-changelog-section').classList.remove('d-none');
          document.getElementById('cm-changelog-body').textContent = json.changelog;
        }
        if (json.versions && json.versions.length) {
          cmRenderVersionHistory(json.versions, json.current_version);
        }
      })
      .catch(function (e) {
        loading.classList.add('d-none');
        errorDiv.classList.remove('d-none');
        document.getElementById('cm-update-error-msg').textContent = e.message || 'Network error';
      });
  }

  // Auto-check on Updates tab activation
  tabLink.addEventListener('shown.bs.tab', function () {
    if (!cmChecked) cmCheckUpdate();
  });

  // Manual refresh button
  checkBtn.addEventListener('click', cmCheckUpdate);

  // Install update
  document.getElementById('cm-install-update').addEventListener('click', function () {
    if (!cmDownloadUrl) return;
    var btn = this;
    btn.disabled = true;
    document.getElementById('cm-install-progress').classList.remove('d-none');
    document.getElementById('cm-install-success').classList.add('d-none');
    document.getElementById('cm-install-error').classList.add('d-none');

    fetch(URL_INSTALL + '&download_url=' + encodeURIComponent(cmDownloadUrl), {
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
    })
      .then(function (r) { return r.text().then(parseJsonOrThrow); })
      .then(function (json) {
        document.getElementById('cm-install-progress').classList.add('d-none');
        if (json.error) {
          document.getElementById('cm-install-error').classList.remove('d-none');
          document.getElementById('cm-install-error-msg').textContent = json.message || 'Install error';
          btn.disabled = false;
          return;
        }
        document.getElementById('cm-install-success').classList.remove('d-none');
        document.getElementById('cm-install-success-msg').textContent = 'v' + (json.new_version || '?') + ' (' + (json.copied || 0) + ' files). Reload the page.';
      })
      .catch(function (e) {
        document.getElementById('cm-install-progress').classList.add('d-none');
        document.getElementById('cm-install-error').classList.remove('d-none');
        document.getElementById('cm-install-error-msg').textContent = e.message || 'Install failed';
        btn.disabled = false;
      });
  });
})();

// ---- Bulk hide empty categories ----
(function () {
  var btn = document.getElementById('cm-bulk-hide-empty');
  if (!btn) return;

  var URL_BULK_HIDE = {{ bulk_hide_empty_url|json_encode|raw }};
  var TEXT_CONFIRM = {{ text_confirm_hide_all_empty|json_encode|raw }};
  var TEXT_DONE = {{ text_hide_all_empty_done|json_encode|raw }};

  btn.addEventListener('click', function () {
    if (!confirm(TEXT_CONFIRM)) return;

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ...';

    fetch(URL_BULK_HIDE, {
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
    })
      .then(function (r) { return r.text(); })
      .then(function (t) {
        var json;
        try { json = JSON.parse(t); } catch (e) { throw new Error('Invalid JSON'); }
        if (json.error) { alert(json.error); btn.disabled = false; return; }
        alert(TEXT_DONE.replace('%d', json.count || 0));
        window.location.reload();
      })
      .catch(function () {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-eye-slash"></i> {{ button_hide_all_empty|escape('js') }}';
      });
  });
})();

// ---- Dashboard drill-down tree ----
(function () {
  var root = document.getElementById('cm-tree-root');
  if (!root) return;

  var URL_TREE = {{ tree_children_url|json_encode|raw }};
  var cache = {};

  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  function fetchChildren(parentId) {
    if (cache[parentId]) return Promise.resolve(cache[parentId]);
    return fetch(URL_TREE + '&parent_id=' + parentId, {
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
    })
      .then(function (r) { return r.json(); })
      .then(function (json) {
        var rows = json.rows || [];
        cache[parentId] = rows;
        return rows;
      });
  }

  function renderNode(row) {
    var node = document.createElement('div');
    node.className = 'cm-tree-node';

    var head = document.createElement('div');
    head.className = 'cm-tree-head';

    var caret = document.createElement('span');
    caret.className = 'cm-tree-caret';
    caret.innerHTML = row.has_children ? '<i class="fa-solid fa-caret-right"></i>' : '<span class="cm-tree-caret-empty"></span>';
    head.appendChild(caret);

    var label = document.createElement('span');
    label.className = 'cm-tree-label';
    label.textContent = row.name;
    head.appendChild(label);

    var total = document.createElement('span');
    total.className = 'badge bg-secondary ms-2';
    total.textContent = row.total;
    head.appendChild(total);

    var scoreWrap = document.createElement('span');
    scoreWrap.className = 'cm-tree-score';
    scoreWrap.innerHTML = '<span class="progress" style="height:6px;width:80px;display:inline-block;vertical-align:middle;">' +
      '<span class="progress-bar bg-success" style="width:' + row.score + '%;"></span></span>' +
      '<small class="text-muted ms-1">' + row.score + '%</small>';
    head.appendChild(scoreWrap);

    node.appendChild(head);

    var childrenDiv = document.createElement('div');
    childrenDiv.className = 'cm-tree-children d-none';
    node.appendChild(childrenDiv);

    var expanded = false;

    if (row.has_children) {
      head.classList.add('cm-tree-head-clickable');
      head.addEventListener('click', function () {
        expanded = !expanded;
        caret.innerHTML = expanded
          ? '<i class="fa-solid fa-caret-down"></i>'
          : '<i class="fa-solid fa-caret-right"></i>';

        if (!expanded) {
          childrenDiv.classList.add('d-none');
          return;
        }

        childrenDiv.classList.remove('d-none');

        if (childrenDiv.dataset.loaded) return;
        childrenDiv.dataset.loaded = '1';
        childrenDiv.innerHTML = '<div class="text-muted small"><i class="fa-solid fa-spinner fa-spin"></i></div>';

        fetchChildren(row.category_id).then(function (rows) {
          childrenDiv.innerHTML = '';
          rows.forEach(function (r) { childrenDiv.appendChild(renderNode(r)); });
        });
      });
    }

    return node;
  }

  fetchChildren(0).then(function (rows) {
    if (!rows.length) {
      root.innerHTML = '<div class="text-muted small">' + esc({{ text_no_results|json_encode|raw }}) + '</div>';
      return;
    }
    rows.forEach(function (r) { root.appendChild(renderNode(r)); });
  });
})();
</script>

